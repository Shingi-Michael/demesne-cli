{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Demesne",
  "version": "0.1.0",
  "identifier": "com.demesne.desktop",
  "build": {
    "beforeDevCommand": "bun ../../scripts/prepare-desktop.ts",
    "beforeBuildCommand": "bun ../../scripts/prepare-desktop.ts",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Demesne",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/demesne-desktop-host",
      "binaries/demesned"
    ],
    "resources": {
      "resources/runtime/": "runtime/"
    },
    "category": "DeveloperTool",
    "shortDescription": "A coding workspace with durable sessions and Agent Drive",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
