{
  "name": "demesne-cli",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "bin": {
    "demesne": "apps/cli/src/main.ts",
    "demesned": "apps/daemon/src/main.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "daemon": "bun run apps/daemon/src/main.ts",
    "demesne": "bun run apps/cli/src/main.ts",
    "build": "bun run build:cli && bun run build:daemon",
    "build:cli": "bun build apps/cli/src/main.ts --compile --outfile dist/demesne && rm -f .*.bun-build",
    "build:daemon": "bun run scripts/build-daemon.ts",
    "clean": "rm -rf dist && rm -f .*.bun-build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "fake:provider": "bun run scripts/fake-provider.ts",
    "graphics": "bun apps/graphics/terminal.ts --live",
    "graphics:setup": "bun scripts/setup-graphics.ts",
    "graphics:check": "bun apps/graphics/check-live.ts",
    "build:graphics": "bun scripts/build-graphics.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "sharp": "^0.35.4",
    "typescript": "7.0.2"
  }
}
