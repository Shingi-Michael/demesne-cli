{
  "name": "demesne-cli",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "bin": {
    "demesned": "apps/daemon/src/main.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "daemon": "bun run apps/daemon/src/main.ts",
    "build": "bun run build:daemon",
    "build:daemon": "bun run scripts/build-daemon.ts",
    "clean": "rm -rf dist apps/desktop/release && rm -f .*.bun-build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "fake:provider": "bun run scripts/fake-provider.ts",
    "desktop": "bun scripts/run-desktop.ts",
    "build:desktop": "bun scripts/build-desktop.ts",
    "desktop:check": "bun scripts/check-desktop.ts",
    "version:bump": "bun run scripts/version.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.1",
    "sharp": "^0.35.4",
    "typescript": "7.0.2"
  }
}
