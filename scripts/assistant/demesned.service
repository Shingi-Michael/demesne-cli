# Demesne's daemon, always on, next to the model. Routines (the assistant's
# scheduled chats) only fire while this runs, so it must not depend on the
# desktop window being open. install.sh fills in @DEMESNED@.

[Unit]
Description=Demesne daemon (assistant)
Wants=llama-server.service
After=llama-server.service

[Service]
ExecStart=@DEMESNED@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
